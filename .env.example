DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Supabase Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Project Settings → Data API → Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Legacy projects may use this name instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Comma-separated list of emails that are automatically granted the admin
# role the first time they sign in. Server-only — never exposed to the browser.
ADMIN_EMAILS=owner@example.com
